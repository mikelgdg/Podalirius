# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Secrets & environment
.env
.env.*
*.secret

# Temporary / logs
nohup.out
*.bak
*.log
.ipynb_checkpoints/

# Project assets (previews, metadata)
assets/previews/
data/metadata/*.xls
data/metadata/*.xlsx
